# Cloudflare Worker's relay endpoint (see docs/dev/deployment/cloudflare.md).
# Not generated by deploy-testnet-contracts.sh -- the Worker URL is only known
# after `wrangler deploy`. Without this, .env.local's dev-only relative
# `/api/relay` leaks into the production build instead (Vite merges env files;
# a key .env.production doesn't define still gets pulled from .env.local),
# posting to the Pages origin itself and failing with HTTP 405.
VITE_SMART_ACCOUNT_RELAYER_URL=https://account-sample-api.dicekey.workers.dev/api/relay
# Same Worker, used as the base for every other /api/* call (pairing session
# relay, guardian recovery, L4 status) -- DevicePairingSetup.tsx,
# GuardianRecoverySetup.tsx, GuardianRemoteOwner.tsx, and GuardianJoin.tsx all
# default to "" without this, which posts to the Pages origin itself (no such
# route there) and fails as "ペアリングの準備に失敗しました" etc. Unlike
# VITE_SMART_ACCOUNT_RELAYER_URL this has no /api/... suffix -- each caller
# appends its own path.
VITE_API_BASE_URL=https://account-sample-api.dicekey.workers.dev
