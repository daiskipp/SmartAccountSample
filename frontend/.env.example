# Public browser configuration. Do not put secret keys or relayer API tokens here.
# The values below must all be from the same localnet or Testnet deployment.
VITE_SMART_ACCOUNT_RPC_URL=https://localhost:5173/rpc
VITE_SMART_ACCOUNT_NETWORK_PASSPHRASE=Standalone Network ; February 2017
VITE_SMART_ACCOUNT_WASM_HASH=
VITE_WEBAUTHN_VERIFIER_ADDRESS=
VITE_ED25519_VERIFIER_ADDRESS=

# Leave empty only when using the Vite HTTPS localnet proxy. Testnet uses the Axum gateway.
VITE_SMART_ACCOUNT_RELAYER_URL=

# Standard and custom policies attached to the recovery rules.
VITE_THRESHOLD_POLICY_ADDRESS=
VITE_RECOVERY_SCOPE_POLICY_ADDRESS=
VITE_TIME_DELAY_POLICY_ADDRESS=
# Optional public-status-compatible deployment of TimeDelayPolicy. Set only
# after deploying the version that exposes get_pending_for_account.
VITE_TIME_DELAY_POLICY_STATUS_ADDRESS=

# Public native Stellar account used by the operator as one L4 signer.
VITE_L4_OPERATOR_ADDRESS=
