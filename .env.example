# Local secrets for the root wrangler tooling (wrangler.toml). Copy to .env
# (gitignored) and fill in real values -- never commit actual secrets here.

# Cloudflare API token used by `pnpm wrangler ...` instead of `wrangler login`
# (useful in containers where the OAuth login flow can't reach a browser).
# Needs at least "Cloudflare Pages: Edit" for `wrangler pages deploy`, plus
# "Workers Scripts: Edit" if also running `wrangler deploy` for the Worker.
CLOUDFLARE_API_TOKEN=

# Only needed if the token is account-scoped (not tied to a single user) and
# wrangler can't resolve the account on its own.
CLOUDFLARE_ACCOUNT_ID=
